  {id:'red', name:'RED 01',color:'#ed3047',duration:30,offset:0},
  {id:'blue',name:'BLU 02',color:'#39a8fa',duration:33,offset:0.12},
  {id:'green',name:'GRN 03',color:'#35c991',duration:31.4,offset:0.06},
  {id:'yellow',name:'YEL 04',color:'#f7c848',duration:32.5,offset:0.24},
  {id:'orange',name:'ORG 05',color:'#ff8b39',duration:30.9,offset:0.33},
  {id:'purple',name:'PUR 06',color:'#b29aff',duration:34.4,offset:0.43},
  {id:'white',name:'WHT 07',color:'#f5f6f8',duration:33.8,offset:0.51},
  {id:'pink',name:'PNK 08',color:'#fc78b7',duration:34.1,offset:0.61},
  {id:'teal',name:'TEL 09',color:'#59d9df',duration:32.7,offset:0.72},
  {id:'silver',name:'SLV 10',color:'#aeb9c5',duration:33.3,offset:0.84},
];
const maxTime = 180;
function progressAt(t: number, duration: number, offset: number) {
  return t / duration + offset;
}
function telemetryAt(time: number, duration: number, offset: number) {
  const phase = (progressAt(time, duration, offset) % 1 + 1) % 1;
  // Synthetic signals to test chart plumbing; never presented as measured telemetry.
  const speed = Math.round(175 + 95 * Math.pow(Math.sin(phase * Math.PI * 6), 2));
  const throttle = Math.round(30 + 70 * Math.pow(Math.sin(phase * Math.PI * 6), 2));
  const brake = Math.max(0, Math.round((1 - throttle / 100) * 85));
  return { phase, speed, throttle, brake };
}
function formatClock(seconds: number) {
  const s = Math.floor(seconds);
  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
}
function MiniChart({ seconds, duration, offset, color }: { seconds: number; duration: number; offset: number; color: string }) {
  const start = Math.max(0, seconds - 40);
  const samples = Array.from({length:81}, (_,i) => {
    const t = start + i * (seconds - start) / 80;
    return telemetryAt(t, duration, offset).speed;
  });
  const points = samples.map((v,i) => `${i*4},${92 - (v-160)*0.58}`).join(' ');
  return <svg className="telemetry-chart" viewBox="0 0 320 105" role="img" aria-label="Simulated speed trend over the previous 40 seconds">
    {[24,48,72,96].map(y => <line key={y} x1="0" y1={y} x2="320" y2={y} stroke="#313945" strokeWidth="1" />)}
    <polyline points={points} stroke={color} strokeWidth="2.6" strokeLinejoin="round" strokeLinecap="round" fill="none" />
  </svg>;
}


