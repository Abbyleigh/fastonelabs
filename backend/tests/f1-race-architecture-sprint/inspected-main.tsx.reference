import React, { useEffect, useMemo, useRef, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { Canvas, useFrame, useThree } from '@react-three/fiber';
import { Grid, OrbitControls } from '@react-three/drei';
import * as THREE from 'three';
import './style.css';
import StrategyLab from './StrategyLab';

type Point2D = [number, number];
type Driver = { id: string; name: string; color: string; duration: number; offset: number };
type RecordedSample = { time: number; progress: number; speed?: number; throttle?: number; brake?: number };
type ReplayFile = { format: 'f1-strategy-lab-replay-v1'; circuit: string; duration: number; drivers: { id: string; name: string; color: string; samples: RecordedSample[] }[] };
// The JSON import is a local, explicit file format, not a direct FastF1 file reader.
function interpolate(samples: RecordedSample[], time: number): RecordedSample {
  if (time <= samples[0].time) return samples[0];
  if (time >= samples[samples.length-1].time) return samples[samples.length-1];
  let lo=0, hi=samples.length-1;
  while (hi-lo>1) { const mid=(hi+lo)>>1; if(samples[mid].time<=time) lo=mid; else hi=mid; }
  const a=samples[lo], b=samples[hi], alpha=(time-a.time)/(b.time-a.time);
  const blend=(k: 'progress'|'speed'|'throttle'|'brake') => a[k] === undefined || b[k] === undefined ? a[k] : a[k]!+(b[k]!-a[k]!)*alpha;
  return {time, progress: blend('progress')!, speed:blend('speed'), throttle:blend('throttle'), brake:blend('brake')};
}
function validateReplay(value: unknown): ReplayFile {
  const r=value as ReplayFile;
  if (!r || r.format!=='f1-strategy-lab-replay-v1' || !Number.isFinite(r.duration) || r.duration<=0 || r.duration>86400 || !Array.isArray(r.drivers) || r.drivers.length<1 || r.drivers.length>24) throw new Error('Invalid replay header or duration');
  for (const d of r.drivers) {
    if(typeof d.id!=='string' || typeof d.name!=='string' || typeof d.color!=='string' || !/^#[0-9a-fA-F]{6}$/.test(d.color) || !Array.isArray(d.samples) || d.samples.length<2 || d.samples.length>200000) throw new Error('Invalid driver data');
    let previous=-1;
    for (const p of d.samples) {
      if (!Number.isFinite(p.time) || p.time<=previous || p.time>r.duration || !Number.isFinite(p.progress) || p.progress<0 || p.progress>10000 || ['speed','throttle','brake'].some(k=> (p as any)[k]!==undefined && !Number.isFinite((p as any)[k]))) throw new Error('Invalid or unsorted samples');
      previous=p.time;
    }
  }
  return r;
}


// Deterministic and explainable toy race model. NOT trained machine learning.
// Lap pace: base pace, tyre degradation, stop penalty, optional slow laps.
function lapSeconds(driver:Driver, lap:number, safety:'none'|'lap25'|'lap48', customPit?:number) {
  const i=DRIVERS.findIndex(d=>d.id===driver.id);
  const pitLap=customPit ?? 23+(i%4)*3;
  const age = lap <= pitLap ? lap-1 : lap-pitLap-1;
  const degradation = (lap <= pitLap ? 0.05 : 0.035)*age + 0.002*age*age;
  const scStart=safety==='lap25'?26:safety==='lap48'?49:999;
  return 81.5 + i*0.28 + degradation - 0.027*(lap-1) + (lap===pitLap+1?22:0) + (lap>=scStart && lap<scStart+3?45:0);
}
function predictProgress(driver:Driver, seconds:number, safety:'none'|'lap25'|'lap48', customPit?:number) {
  // Preserve the previously working grid start delay.
  const gridPosition = DRIVERS.findIndex(d => d.id === driver.id);
  const startingGap = Math.max(0, gridPosition) * 0.65;
  let remaining=Math.max(0,seconds-startingGap);
  for(let lap=1;lap<=71;lap++) {
    const duration=lapSeconds(driver,lap,safety,customPit);
    if(remaining<duration) return (lap-1)+remaining/duration;
    remaining-=duration;
  }
  return 71;
}
function predictionsFor(drivers:Driver[], safety:'none'|'lap25'|'lap48', selectedDriver?:string, selectedPit?:number) {
  return drivers.map((d,i)=>({id:d.id,name:d.name,pitLap:d.id===selectedDriver?selectedPit??30:23+(i%4)*3,finish:Array.from({length:71},(_,j)=>lapSeconds(d,j+1,safety,d.id===selectedDriver?selectedPit:undefined)).reduce((a,b)=>a+b,0)})).sort((a,b)=>a.finish-b.finish);
}

// VISUAL RACECRAFT: independent of the 71-lap race-time model.
// This is deterministic visual lane positioning, not collision physics.
function visualRaceProgress(driver: Driver, time: number, safety: 'none'|'lap25'|'lap48', pit?: number): number {
  const index = DRIVERS.findIndex(d => d.id === driver.id);
  const predicted = predictProgress(driver, time, safety, pit);
  // Show a separated starting grid before the race has had time to spread out.
  // Blend out this *visual* grid displacement within the first 12 seconds.
  const blend = Math.max(0, 1 - time / 12);
  return predicted - index * 0.0075 * blend;
}
function lateralRaceOffset(
  driver: Driver,
  time: number,
  drivers: Driver[],
  safety: 'none'|'lap25'|'lap48',
  selectedId: string,
  selectedPit: number
): number {
  const index = drivers.findIndex(d => d.id === driver.id);
  // F1-style two-column starting grid: alternating left and right.
  const side = index % 2 === 0 ? -1 : 1;
  const initial = Math.max(0, 1 - time / 12);
  const gridLane = side * 1.25 * initial;
  const myProgress = visualRaceProgress(driver, time, safety, driver.id === selectedId ? selectedPit : undefined);
  let closest = Infinity;
  for (const other of drivers) {
    if (other.id === driver.id) continue;
    const theirProgress = visualRaceProgress(other, time, safety, other.id === selectedId ? selectedPit : undefined);
    // Another car just ahead, including the start/finish wraparound.
    const distance = ((theirProgress - myProgress) % 1 + 1) % 1;
    if (distance > 0.0001 && distance < closest) closest = distance;
  }
  // Make a passing lane as we close on a car. Return to centreline afterwards.
  const passing = Math.max(0, Math.min(1, (0.026 - closest) / 0.018));
  return gridLane + (1 - initial) * side * 1.25 * passing;
}

