    "cars": {
      "items": {
        "$ref": "#/$defs/CarState"
      },
      "title": "Cars",
      "type": "array"
    },
    "flags": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flags"
    },
    "events": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Events"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "schemaVersion",
    "sourceKind",
    "raceId",
    "sessionId",
    "event",
    "timestampS",
    "timestampUtc",
    "windowStartS",
    "trackLengthM",
    "totalLaps",
    "status",
    "cars",
    "flags",
    "events",
    "provenance"
  ],
  "title": "UnifiedRaceState",
  "type": "object"
}
